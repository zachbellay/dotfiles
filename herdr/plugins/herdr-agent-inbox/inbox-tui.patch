+def inbox_palette():
+    """Explicit inbox colors, independent of the terminal's default palette."""
+    colors = {
+        "background": "#1c1c1c", "text": "#eeeeee", "muted": "#bcbcbc",
+        "selection_background": "#005faf", "selection_text": "#ffffff",
+        "red": "#ff8787", "yellow": "#ffdf87", "green": "#afffaf",
+        "teal": "#87ffff", "blue": "#afd7ff", "accent": "#d7d7d7",
+        "mauve": "#d7afff",
+    }
+    config_dir = os.environ.get("HERDR_PLUGIN_CONFIG_DIR") or os.path.expanduser(
+        "~/.config/herdr/plugins/config/herdr-agent-inbox")
+    try:
+        with open(os.path.join(config_dir, "inbox-theme.json")) as f:
+            overrides = json.load(f)
+        if isinstance(overrides, dict):
+            for key, value in overrides.items():
+                if key in colors and isinstance(value, str) and len(value) == 7:
+                    if value.startswith("#"):
+                        try:
+                            int(value[1:], 16)
+                        except ValueError:
+                            continue
+                        colors[key] = value
+    except (OSError, ValueError):
+        pass
+    return {key: tuple(int(value[i:i + 2], 16) for i in (1, 3, 5))
+            for key, value in colors.items()}
+
